# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
/coverage
.nyc_output/

# next.js
/.next/
/out/

# production
/build
dist/

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (commit .env.example only)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.idea/
*.swp
*.swo

# SpecStory local metadata
.specstory/

# Claude Code local session settings
.claude/

# Local database state
postgres-data/
*.db
*.sqlite

# Drizzle local cache
drizzle/.cache/

# Playwright
test-results/
playwright-report/
playwright/.cache/
