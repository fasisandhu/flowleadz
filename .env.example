NODE_ENV=development
DATABASE_URL=postgres://crm:crm@localhost:5433/crm
BETTER_AUTH_SECRET=replace-with-32-plus-character-random-string-from-openssl
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-random-16-plus-character-string

# Optional in dev (features fail at runtime if invoked unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

LOG_LEVEL=debug

# Set to 1 in local dev / CI to disable Better Auth rate limiting for E2E tests.
# Do NOT set in production deployments.
DISABLE_RATE_LIMIT=

# ============================================================================
# FlowLeadz public site (app/(site)/*)
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://flowleadz.com
LEAD_TO_EMAIL=hello@flowleadz.com
LEAD_FROM_EMAIL="FlowLeadz Site <noreply@flowleadz.com>"

# Optional lead-pipeline integrations (leave unset to skip)
LEAD_WEBHOOK_URL=

# Airtable lead storage
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Google Sheets lead storage
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_RANGE=Leads!A:H

# Cal.com booking embed + webhook
NEXT_PUBLIC_CAL_USERNAME=your-calcom-username
NEXT_PUBLIC_CAL_EVENT_SLUG=strategy-call
CAL_WEBHOOK_SECRET=
CAL_BOOKING_WEBHOOK_URL=
